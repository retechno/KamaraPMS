# Settings of the production-like stack (deploy/compose.yaml). Copy this file to deploy/.env and fill it in. deploy/.env is ignored by git and is never baked into an image.
# docs/deployment.md explains every variable.

# --- Database (the PostgreSQL container of the stack; with an external database set PMS_DATABASE_URL in the compose file instead) ---
POSTGRES_DB=pms
POSTGRES_USER=pms
# Required. Generate one:  openssl rand -base64 24 | tr -d '/+=' 
POSTGRES_PASSWORD=

# --- Secrets ---
# Required, at least 32 characters. Generate one:  openssl rand -base64 48
# Changing it signs every user out (access tokens are signed with it); it is not used to protect stored data.
PMS_JWT_SECRET=

# --- Application ---
PMS_LOG_LEVEL=info
# Refresh cookie over HTTPS only. true in production (the application refuses false there). A browser accepts it from http://localhost too, so the stack can be tried locally.
PMS_COOKIE_SECURE=true
PMS_ACCESS_TOKEN_TTL=15m
PMS_REFRESH_TOKEN_TTL=720h
PMS_DB_MAX_CONNS=10
PMS_DB_LOCK_TIMEOUT=5s
PMS_SHUTDOWN_TIMEOUT=15s
# Requests a minute per client address (the real client, behind the trusted proxy); 0 turns the limit off.
PMS_RATE_LIMIT_PER_MINUTE=600
# The proxies whose X-Forwarded-For the API believes: addresses or CIDR ranges, comma separated. The compose file gives the proxy the fixed address 172.29.0.10 on its own
# network. If a load balancer stands in front of the proxy, see docs/deployment.md before changing anything.
PMS_TRUSTED_PROXIES=172.29.0.10

# --- E-mail (the reservation confirmation). Empty host = e-mail off. ---
PMS_SMTP_HOST=
PMS_SMTP_PORT=587
PMS_SMTP_TLS=starttls
PMS_SMTP_USERNAME=
PMS_SMTP_PASSWORD=
PMS_SMTP_FROM=
PMS_SMTP_FROM_NAME=

# --- The stack ---
# The address the proxy listens on at the host. 127.0.0.1 keeps it on this machine (right for trying it out); 0.0.0.0 opens it to the network (a server, behind a firewall).
PMS_BIND=127.0.0.1
PMS_PUBLIC_PORT=8080
# Only for the TLS variant (deploy/compose.tls.yaml)
PMS_PUBLIC_TLS_PORT=8443
# The tag of the images this stack builds and runs.
PMS_VERSION=local
