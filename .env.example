# Copy to .env and adjust. All settings are read from the environment (internal/platform/config).
PMS_ENV=development
PMS_HTTP_ADDR=127.0.0.1:18080
PMS_DATABASE_URL=postgres://pms:pms@localhost:55432/pms?sslmode=disable
PMS_DB_MAX_CONNS=10
PMS_DB_LOCK_TIMEOUT=5s
PMS_LOG_LEVEL=info
PMS_LOG_FORMAT=text
PMS_SHUTDOWN_TIMEOUT=15s
PMS_MIGRATE_ON_START=false

# Authentication. Generate a secret with: openssl rand -base64 48   (at least 32 characters)
PMS_JWT_SECRET=
PMS_ACCESS_TOKEN_TTL=15m
PMS_REFRESH_TOKEN_TTL=720h
# Refresh cookie over HTTPS only. Defaults to false in development (http://localhost), true otherwise.
# PMS_COOKIE_SECURE=false
# PMS_RATE_LIMIT_PER_MINUTE=600   # requests per minute per client address; 0 disables

# E-mail (the reservation confirmation, with the confirmation PDF attached). Leave PMS_SMTP_HOST empty to switch
# e-mail off: nothing is queued and the reservation screen says so. Messages go through an outbox and a background
# worker, so a mail server that is down never blocks a booking; each message is tried up to five times.
# PMS_SMTP_HOST=smtp.example.com
# PMS_SMTP_PORT=587
# PMS_SMTP_TLS=starttls            # starttls (587), tls (465, implicit TLS) or none (a local test server only)
# PMS_SMTP_USERNAME=
# PMS_SMTP_PASSWORD=
# PMS_SMTP_FROM=reservations@hotel.example
# PMS_SMTP_FROM_NAME=Hotel Bali

# Optional: run database tests against an existing EMPTY database instead of testcontainers.
# PMS_TEST_DATABASE_URL=postgres://pms:pms@localhost:55432/pms_test?sslmode=disable
